{
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.28.5",
	"engines": {
		"node": ">=24",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "vp dev",
		"preview": "vp preview",
		"build": "vp build",
		"prepare": "concurrently --group --prefix-colors 'auto' 'pnpm:prepare:*'",
		"prepare:husky": "husky",
		"lint": "concurrently --group --prefix-colors 'auto' 'pnpm:lint:*'",
		"lint:eslint": "eslint .",
		"lint:cspell": "cspell --no-progress --no-summary --no-must-find-files .",
		"lint:knip": "knip --no-progress",
		"fix": "concurrently --group --prefix-colors 'auto' 'pnpm:fix:*'",
		"fix:eslint": "eslint --fix .",
		"fix:knip": "knip --fix --no-progress --workspace ."
	},
	"dependencies": {
		"vue": "catalog:"
	},
	"devDependencies": {
		"@commitlint/cli": "catalog:",
		"@somehow-digital/commitlint-config": "catalog:",
		"@somehow-digital/cspell-dictionary": "catalog:",
		"@somehow-digital/eslint-config": "catalog:",
		"@somehow-digital/typescript-config": "catalog:",
		"@somehow-digital/unocss-preset": "catalog:",
		"@unocss/preset-web-fonts": "catalog:",
		"@vitejs/plugin-vue": "catalog:",
		"concurrently": "catalog:",
		"cspell": "catalog:",
		"eslint": "catalog:",
		"husky": "catalog:",
		"knip": "catalog:",
		"lint-staged": "catalog:",
		"tinyglobby": "catalog:",
		"unocss": "catalog:",
		"vite": "catalog:",
		"vite-plugin-restart": "catalog:",
		"vite-plugin-vue-devtools": "catalog:",
		"vite-plus": "catalog:"
	}
}
